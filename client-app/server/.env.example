# ═══════════════════════════════════════════════════════════════
# MITHRA LIFE OS — Server Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase service_role key (required for workspace ownership transfer)
# Get from Supabase Dashboard → Settings → API → service_role key (keep SECRET, never expose to frontend)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# AI (required for Dost AI chat)
GEMINI_API_KEY=your-gemini-api-key

# Environment
ENVIRONMENT=development

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
