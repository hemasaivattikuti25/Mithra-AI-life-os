# ═══════════════════════════════════════════════════════════════
# MITHRA LIFE OS — Server Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# Database (Supabase PostgreSQL / Neon)
# Direct connection (port 5432) or Transaction Pooler (port 6543)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase Admin SDK (required — paste the full JSON from your Firebase service account key)
FIREBASE_SERVICE_ACCOUNT_JSON={}

# AI (required for Dost AI chat & planner via NVIDIA NIM)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Environment
ENVIRONMENT=development
