# ============================================================
# MITHRA LIFE OS — ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Supabase (required for cloud sync) ──────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── App URL (used for OAuth redirects) ──────────────────────
VITE_APP_URL=http://localhost:5173

# ── Backend API URL ─────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Google OAuth (configured in Supabase dashboard) ─────────
# No client secret needed here — handled by Supabase.
# Just ensure your Google OAuth redirect URI is set to:
# https://<your-project>.supabase.co/auth/v1/callback

# ──────────────────────────────────────────────────────────────
# BACKEND (server/.env)
# ──────────────────────────────────────────────────────────────

# Supabase service role key (for backend only — NOT anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS (comma-separated, no spaces)
ALLOWED_ORIGINS=https://mithra-lifeos.com,https://www.mithra-lifeos.com,http://localhost:5173

# JWT Secret (used for token validation)
JWT_SECRET=your-random-secret-string-here
